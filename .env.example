# Public https address of this server (no trailing slash). The MCP connector URL is PUBLIC_URL/mcp
PUBLIC_URL=http://localhost:3000
PORT=3000

# Postgres. Supabase: project -> Connect -> Transaction pooler (port 6543) URI.
# Leave empty to use a local embedded database stored in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=./data

# X (Twitter) login: developer.x.com -> your app -> User authentication settings -> OAuth 2.0,
# type "Web App", callback URL = PUBLIC_URL/login/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
X_MIN_ACCOUNT_AGE_DAYS=30

# Test server only: free faucet and sign-in by typing any handle. Never enable on the real server.
TEST_MODE=1
DEV_LOGIN=1

# Deposits in USDC/USDT on Solana (see README "Deposits"). Both unset = deposits off.
# HELIUS_API_KEY: helius.dev dashboard. DEPOSIT_POOL_KEY: printed by `npm run deposit-pool` on your own computer,
# which also writes the CSV of deposit addresses to import into the deposit_pool table. The seed phrase itself
# never goes into any environment variable.
HELIUS_API_KEY=
DEPOSIT_POOL_KEY=
# devnet when TEST_MODE=1, mainnet otherwise; the other combinations are refused
# SOLANA_CLUSTER=devnet
# Optional: any Solana RPC instead of Helius', and an explicit webhook password (default: derived from the pool key)
# SOLANA_RPC_URL=
# HELIUS_WEBHOOK_SECRET=
MIN_DEPOSIT_USD=0.01

# Manual credit endpoint for support cases (POST /admin/deposit). Unset = disabled.
ADMIN_TOKEN=

# Prices in $MCP (1 $MCP = $1)
MINT_PRICE_USD=5
MINT_LIMIT_PER_USER=5
FEE_BPS=250
# MCP NFTs: "after_sold_out" (the real server's default) keeps them off the market until all are minted;
# "open" lets them trade right away, handy locally (npm run demo lists some)
MCP_TRADING=open
# Withdrawals: the payout hot wallet (keep a small float on it). Unset = withdrawals off.
WITHDRAW_WALLET_KEY=
MIN_WITHDRAW_USD=5
WITHDRAW_FEE=0.5
WITHDRAW_AUTO_MAX=100
WITHDRAW_USER_DAILY=300
WITHDRAW_DAILY=1000
# a cap on everything paid out per 24 hours, approved or not (default: twice WITHDRAW_DAILY)
# WITHDRAW_HARD_DAILY=2000
# off: no limits and no manual check queue, every withdrawal goes out right away. The hot wallet's balance is then
# the only cap, plus WITHDRAW_HARD_DAILY if you set it (recommended).
# WITHDRAW_LIMITS=off
# rows are signed with a key derived from DEPOSIT_POOL_KEY; set WITHDRAW_MAC_KEY (64 hex) to use another
# WITHDRAW_MAC_KEY=
# WITHDRAW_PRIORITY_FEE=auto
# WITHDRAW_ADDRESS_DELAY_HOURS=24
# WITHDRAWALS_PAUSED=1
# Explorer: the owner's cold wallets that hold swept deposits count as reserves (public addresses, comma-separated)
# RESERVE_WALLETS=
# how often the chain's latest hash is written to Solana from the payout wallet (minutes); ANCHORS_OFF=1 stops it
# ANCHOR_EVERY_MINUTES=60
# RESERVES_EVERY_MINUTES=10
FAUCET_USD=20
